# Secrets — NEXT_PUBLIC_* values get inlined into the client bundle at build
# time, and any other key here would be baked into a layer.
.env
.env.*
**/.env
**/.env.*

# Installed by `npm ci` in the deps stage — copying the host's copy over it
# defeats the clean install and can smuggle in host-specific binaries.
node_modules/

# Build output — regenerated by `npm run build`
.next/
out/
*.tsbuildinfo

# VCS and tooling
.git/
.gitignore

# Not part of the frontend build
comfy_client.py
setup_comfyui.sh
__pycache__/
